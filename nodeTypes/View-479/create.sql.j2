{# == Node Type Name           : Work  == #}
{# == Node Type Description    : This node creates work table or view  == #}
{#---------------------------------------------------------------------------------------------#}


{{ stage('Create view') }}
CREATE OR REPLACE VIEW {{ this }}
(
    {%- for col in columns %}
        "{{ col.name }}"
        {%- if withTags and col.tag %} WITH TAG ({{ tag_list(col.tag) }}){% endif %}
        {%- if col.description | trim | length > 0 %} COMMENT '{{ col.description | escape }}'{% endif %}
        {%- if not loop.last -%}, {%- endif %}
    {%- endfor %}
)
{%- if node.description | trim | length > 0 %} COMMENT = '{{ node.description | escape }}'{% endif %}
{%- if withTags and config.tag %} WITH TAG ({{ tag_list(config.tag) }}){% endif %}
AS
{{ sources[0].cteString }}
SELECT {{ sources[0].selectModifier | default('', true) }}
{%- for col in sources[0].columns %}
    {%- if col.isSurrogateKey or col.isSystemVersion or col.isSystemCurrentFlag
            or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate %}
    CAST(NULL AS {{ col.dataType }}) AS "{{ col.name }}"
    {%- else %}
    {{ get_source_transform(col) }} AS "{{ col.name }}"
    {%- endif %}
    {%- if not loop.last -%}, {%- endif %}
{%- endfor %}
{{ sources[0].join }}
